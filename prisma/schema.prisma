// RunA Log Technologies — database schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Project inquiries submitted through the contact / "Start a Project" form.
// Managed in the admin panel (/admin).
model ProjectInquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  company     String?
  service     String // serviceOptions slug
  budget      String? // budgetOptions label, optional
  timeline    String? // timelineOptions label, optional
  description String
  // Admin workflow: new | read | replied | converted | archived
  status      String   @default("new")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead?
}

// A lead tracked by the sales workflow (added manually, imported from
// CSV/XLSX, or converted from a website inquiry).
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  // manual | import | website
  source    String   @default("manual")
  // Pipeline: new | contacted | qualified | proposal | negotiation | won | lost
  status    String   @default("new")
  value     Float? // potential deal value (USD)
  notes     String?
  inquiryId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiry    ProjectInquiry? @relation(fields: [inquiryId], references: [id])
  activities Activity[]
  client     Client?
}

// A scheduled call / meeting / follow-up with a lead.
model Activity {
  id          String   @id @default(cuid())
  leadId      String
  // call | meeting | email | follow-up
  type        String   @default("call")
  title       String
  scheduledAt DateTime
  // scheduled | completed | cancelled
  status      String   @default("scheduled")
  outcome     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// A paying / onboarded client, usually converted from a won lead.
model Client {
  id        String   @id @default(cuid())
  leadId    String?  @unique
  name      String
  email     String?
  phone     String?
  company   String?
  service   String?
  // onboarding | active | paused | completed | churned
  status    String   @default("onboarding")
  value     Float?
  startDate DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
}
