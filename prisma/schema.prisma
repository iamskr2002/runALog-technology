// RunA Log Technologies — database schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Project inquiries submitted through the contact / "Start a Project" form.
// Managed in the admin panel (/admin).
model ProjectInquiry {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  company     String?
  service     String // serviceOptions slug
  budget      String? // budgetOptions label, optional
  timeline    String? // timelineOptions label, optional
  description String
  // Admin workflow: new | read | replied | converted | archived
  status      String   @default("new")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead?
}

// A team member who can sign in to the staff panel (/staff) and work
// their assigned leads. Passwords are scrypt hashes (see src/lib/password.ts).
model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  // admin — full access everywhere | staff — only their assigned leads
  role         String    @default("staff")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads Lead[]     @relation("LeadAssignee")
  activities    Activity[] @relation("ActivityCreator")
}

// A lead tracked by the sales workflow (added manually, imported from
// CSV/XLSX, or converted from a website inquiry).
model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  // manual | import | website
  source    String   @default("manual")
  // Pipeline: new | contacted | qualified | proposal | negotiation | won | lost
  status    String   @default("new")
  value     Float? // potential deal value (USD)
  notes     String?
  inquiryId String?  @unique
  // Staff member responsible for this lead (null = unassigned, admin pool).
  assignedToId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inquiry    ProjectInquiry? @relation(fields: [inquiryId], references: [id])
  assignedTo Staff?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  activities Activity[]
  client     Client?

  @@index([assignedToId])
}

// A scheduled call / meeting / follow-up with a lead.
model Activity {
  id          String   @id @default(cuid())
  leadId      String
  // call | meeting | email | follow-up
  type        String   @default("call")
  title       String
  scheduledAt DateTime
  // scheduled | completed | cancelled
  status      String   @default("scheduled")
  outcome     String?
  notes       String?
  // Staff member who scheduled the activity (null = owner/admin via panel).
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdBy Staff? @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([createdById])
}

// A paying / onboarded client, usually converted from a won lead.
model Client {
  id        String   @id @default(cuid())
  leadId    String?  @unique
  name      String
  email     String?
  phone     String?
  company   String?
  service   String?
  // onboarding | active | paused | completed | churned
  status    String   @default("onboarding")
  value     Float?
  startDate DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
}
